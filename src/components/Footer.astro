---
import { footerNav, legalNav, site } from "../data/site";
import { services } from "../data/services";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="bg-navy-deep text-white/80 shingle-texture">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10 py-16 grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-bold text-white">{site.name}</p>
      <p class="mt-3 text-sm leading-relaxed">
        Serving the Greater Toronto Area with residential and commercial roofing solutions.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-white/50 tracking-wide uppercase">Navigation</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          footerNav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white/50 tracking-wide uppercase">Services</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          services.slice(0, 6).map((s) => (
            <li>
              <a href={`/services#${s.slug}`} class="hover:text-white transition-colors">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-white/50 tracking-wide uppercase">Contact</p>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={site.phoneHref} class="flex items-center gap-2 hover:text-white transition-colors">
            <Icon name="phone" class="size-4 text-blue-bright" />
            {site.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={site.emailHref} class="flex items-center gap-2 hover:text-white transition-colors break-all">
            <Icon name="mail" class="size-4 text-blue-bright" />
            {site.email}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="clock" class="size-4 text-blue-bright" />
          {site.hours}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-[1280px] px-6 lg:px-10 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50">
      <p>&copy; {year} {site.name}. All Rights Reserved.</p>
      <div class="flex gap-6">
        {
          legalNav.map((item) => (
            <a href={item.href} class="hover:text-white transition-colors">
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
