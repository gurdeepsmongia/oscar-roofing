---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";

const lastUpdated = new Date().toLocaleDateString("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Privacy Policy | Oscar Roofing"
  description="Oscar Roofing's privacy policy — how we collect, use, and protect information submitted through this website."
  path="/privacy-policy"
>
  <PageHero title="Privacy Policy" />

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-[760px] px-6 lg:px-10">
      <p class="text-sm text-ink-soft italic">
        This is a general privacy policy template for a small Ontario home-services business. It
        has not been reviewed by a lawyer and should be reviewed before relying on it as a legal
        document.
      </p>
      <p class="mt-4 text-sm text-ink-soft">Last updated: {lastUpdated}</p>

      <div class="mt-10 space-y-8 text-ink-soft leading-relaxed">
        <div>
          <h2 class="font-display text-xl font-bold text-navy">Information We Collect</h2>
          <p class="mt-3">
            When you submit our quote request form, we collect the information you provide,
            which may include your name, email address, phone number, property address, city,
            preferred contact method, and any message you include about your roofing project.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-navy">How We Use Your Information</h2>
          <p class="mt-3">
            We use the information you submit only to respond to your quote request, discuss your
            roofing project, and communicate with you about our services. We do not sell your
            information to third parties.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-navy">Third-Party Form Processing</h2>
          <p class="mt-3">
            Quote request submissions on this website are processed by a third-party form service
            (Web3Forms) that delivers your submission to our email inbox. That service may
            process your information according to its own privacy policy.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-navy">Cookies &amp; Tracking</h2>
          <p class="mt-3">
            This website does not currently use analytics or advertising cookies. If that changes
            in the future, this policy will be updated accordingly.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-navy">Data Security</h2>
          <p class="mt-3">
            We take reasonable steps to protect the information submitted to us. No method of
            electronic transmission or storage is completely secure, and we cannot guarantee
            absolute security.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-navy">Contact Us</h2>
          <p class="mt-3">
            If you have questions about this privacy policy or how your information is handled,
            contact us at{" "}
            <a href={site.emailHref} class="text-blue-bright font-semibold">{site.email}</a> or{" "}
            <a href={site.phoneHref} class="text-blue-bright font-semibold">{site.phoneDisplay}</a>.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-navy">Changes to This Policy</h2>
          <p class="mt-3">
            We may update this privacy policy from time to time. Changes will be posted on this
            page with an updated revision date.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
