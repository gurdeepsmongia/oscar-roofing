---
// Custom line-icon set — deliberately not a generic icon-pack (no Font Awesome /
// Heroicons glyphs). Stroke-based, 1.6px weight, matched to the Manrope/Inter
// type system. Add new paths here rather than pulling in an icon dependency.
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "size-6" } = Astro.props;

const paths: Record<string, string> = {
  replace: "M4 12h4l3-7 4 14 3-7h4 M4 12a8 8 0 0 0 14.5 4.8M20 12a8 8 0 0 0-14.5-4.8",
  repair: "M14.5 3.5 17 6l-4.5 4.5 1 1L18 7l2.5 2.5-6 6-2-2-6 6H4v-2.5l6-6-2-2 6-6Z",
  shingle: "M3 8h6v6H3zM10 8h6v6h-6zM17 8h4v6h-4zM3 15h6v6H3zM10 15h6v6h-6z",
  flat: "M3 8h18v3H3zM5 11v9M19 11v9M5 20h14M9 14h2v3H9zM13 14h2v3h-2z",
  emergency: "M13 2 4 14h6l-1 8 9-12h-6l1-8Z",
  inspection: "M11 3a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 4v4l3 2M20 20l-3.2-3.2",
  skylight: "M12 3v3M5.6 5.6l2.1 2.1M18.4 5.6l-2.1 2.1M4 14h16l-2 7H6l-2-7Zm0 0 8-6 8 6",
  soffit: "M3 10 12 4l9 6M5 10v3h14v-3M4 13h16v2H4zM7 15v2M12 15v2M17 15v2",
  gutter: "M4 6h16M4 6v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6M9 11v9M9 20h3",
  insulation: "M4 20V9l8-6 8 6v11M9 20v-6h6v6",
  ventilation: "M4 12a8 8 0 1 1 16 0M4 12c0 4 2 8 8 8M20 12c0 4-2 8-8 8M4 12h16",
  residential: "M4 21V10l8-6 8 6v11M9 21v-7h6v7",
  commercial: "M4 21V4h9v17M13 21h7V10h-7M7 8h1M7 12h1M7 16h1",
  phone: "M6 3h3l1.5 4.5L8 9.5a12 12 0 0 0 6.5 6.5l2-2.5L21 15v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z",
  mail: "M3 6h18v12H3Zm0 0 9 7 9-7",
  clock: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 5v4l3 2",
  "map-pin": "M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M5 5l14 14M19 5 5 19",
  check: "M5 12.5 9.5 17 19 7",
  "chevron-right": "M9 5l7 7-7 7",
  "arrow-right": "M4 12h15M13 6l6 6-6 6",
  quote: "M3 8h18v3H3zM5 11v9M19 11v9M5 20h14",
};

const d = paths[name] ?? paths.check;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
