---
interface Props {
  number: number;
  title: string;
  description: string;
  isLast?: boolean;
}

const { number, title, description, isLast = false } = Astro.props;
---

<div class="relative flex-1" data-reveal>
  {!isLast && (
    <div class="hidden md:block absolute top-6 left-[calc(50%+28px)] right-0 h-px bg-navy/15" aria-hidden="true"></div>
  )}
  <div class="flex md:flex-col items-center md:text-center gap-4 md:gap-0">
    <div class="shrink-0 flex items-center justify-center size-12 rounded-full bg-navy font-display font-bold text-white">
      {number}
    </div>
    <div class="md:mt-5">
      <h3 class="font-display text-base font-bold text-navy">{title}</h3>
      <p class="mt-1.5 text-sm leading-relaxed text-ink-soft max-w-[220px] md:mx-auto">{description}</p>
    </div>
  </div>
</div>
