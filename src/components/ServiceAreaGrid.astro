---
import { cities } from "../data/services";
---

<section class="bg-gray-light">
  <div class="mx-auto max-w-[1280px] px-6 lg:px-10 py-20 md:py-24">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-semibold tracking-wide uppercase text-blue">Service Area</p>
      <h2 class="mt-3 font-display text-3xl md:text-4xl font-bold text-navy">
        Serving Homeowners &amp; Businesses Across the GTA
      </h2>
      <p class="mt-4 text-ink-soft leading-relaxed">
        Oscar Roofing proudly serves customers throughout the Greater Toronto Area, providing
        roofing solutions for residential and commercial properties.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      {
        cities.map((city) => (
          <span class="rounded-full bg-white border border-black/5 px-4 py-2 text-sm font-medium text-ink shadow-[0_1px_2px_rgba(11,31,58,0.05)]">
            {city}
          </span>
        ))
      }
      <span class="rounded-full bg-navy/5 border border-navy/10 px-4 py-2 text-sm font-medium text-navy">
        &amp; other GTA communities
      </span>
    </div>
  </div>
</section>
